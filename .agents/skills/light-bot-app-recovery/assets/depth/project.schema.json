{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-systems:depth:2",
  "title": "Additive bounded project depth projection; not quality certification",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "maturity",
    "scope",
    "consumer",
    "requirements",
    "systems",
    "contracts",
    "operations",
    "capabilities",
    "recipes",
    "attempts",
    "transformations",
    "assemblies",
    "evidence",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "depth/2"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "enum": [
        "draft",
        "design",
        "production"
