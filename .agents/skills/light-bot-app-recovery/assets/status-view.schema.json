  "title": "Read-only projection of native project claims; not an approval or execution certificate",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "domain",
    "source",
    "project_id",
    "goal",
    "scope",
    "workflow_status",
    "pause",
    "current_work",
    "pending_work",
    "recorded_completed_work",
