        "path": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "native_schema": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "record_integrity": {
          "enum": [
            "snapshot_and_journal_match",
            "no_native_snapshot_signature"
          ]
        }
      },
      "additionalProperties": false
    },
