                            <section style="margin-top: 0" data-id="6391" class="section   section--no-padding section-class6 ">
<div class="container  " id="6391">

            <div class="m-faq__inner">
            <div class="m-faq__row">
                <div class="faq">
                    <div class="faq__head">
                        <div class="faq__icon">
                                                        <img src="/media/page/page-icon-6391.svg"/>
                                                    </div>
                                                <h5 class="faq__title faq__title--main">Якщо в графіку відключень:</h5>
                                            </div>
                    <div class="faq__body">
                                                <div class="faq__container faq__faq-list">
                                                                                    <div style="height: 0px;"> </div>
<ul>
<li><span lang="UK">відсутня потрібна вам адреса</span></li>
<li class="MsoNormal"><span lang="UK">відсутнє світло у зоні, що гарантує його наявність (на графіку <strong>білий колір</strong>)</span></li>
</ul>

                                                        
                        </div>
                                                                            <a class="button" href="javascript:void(0);" data-micromodal-trigger="modal-complaints-outage-schedule-new">
                                Повідомте нас                            </a>
                                            </div>
                </div>

                <div class="faq">
                    <div class="faq__head">
                        <div class="faq__icon">
                                                        <img src="/media/page/page-icon-right-6391.png"/>
                                                    </div>
                                                <h5 class="faq__title faq__title--main">Якщо у вас відсутнє світло і:</h5>
                                            </div>
                    <div class="faq__body">
                                                <div class="faq__container faq__faq-list">
                                                                                    <div style="height: 0px;"> </div>
<ul>
<li><span lang="UK">відключення за вашою адресою не зафіксовано</span></li>
<li><span lang="UK">немає термінів повернення світла у вашу оселю</span></li>
</ul>

                                                        
                        </div>
                                                                            <a class="button" href="javascript:void(0);" data-micromodal-trigger="modal-fail-electricity">
                                Повідомте нас                            </a>
                                            </div>
